<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
  >

  <meta name="theme-color" content="#16a34a">

  <title>우리가게 열기</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      margin: 0;
    }

    body {
      min-height: 100vh;
      padding: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f4f7fb;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
      color: #111827;
    }

    .card {
      width: 100%;
      max-width: 420px;
      padding: 30px 22px;
      background: #ffffff;
      border-radius: 18px;
      box-shadow: 0 10px 35px rgba(15, 23, 42, 0.1);
      text-align: center;
    }

    h1 {
      margin: 0 0 14px;
      font-size: 24px;
      line-height: 1.4;
    }

    p {
      margin: 0;
      color: #64748b;
      font-size: 15px;
      line-height: 1.7;
      word-break: keep-all;
    }

    .error {
      color: #dc2626;
      font-weight: 700;
    }
  </style>
</head>

<body>

  <section class="card">
    <h1 id="title">우리가게를 열고 있습니다</h1>

    <p id="message">
      잠시만 기다려 주세요.
    </p>
  </section>

  <script>
    "use strict";

    const STORE_CODE_KEY =
      "wooriapt_store_code";

    const STORE_PATH_KEY =
      "wooriapt_store_path";

    const STORE_URL_KEY =
      "wooriapt_store_url";

    const STORE_NO_KEY =
      "wooriapt_store_no";

    const title =
      document.getElementById("title");

    const message =
      document.getElementById("message");

    function cleanStoreCode(value) {
      return String(value || "")
        .trim()
        .toUpperCase()
        .replace(/[^A-Z0-9_-]/g, "");
    }

    function cleanStoreUrl(value) {
      const digits =
        String(value || "")
          .replace(/[^0-9]/g, "");

      if (!digits) {
        return "";
      }

      const number =
        Number(digits);

      if (
        !Number.isInteger(number) ||
        number <= 0
      ) {
        return "";
      }

      return "/" + number;
    }

    function deriveStoreUrl(storeCode) {
      const cleanCode =
        cleanStoreCode(storeCode);

      const parts =
        cleanCode.split("-");

      const lastPart =
        parts[parts.length - 1] || "";

      if (!/^[0-9]+$/.test(lastPart)) {
        return "";
      }

      return cleanStoreUrl(lastPart);
    }

    function getStoreUrl() {
      const savedUrl =
        localStorage.getItem(
          STORE_URL_KEY
        );

      const cleanUrl =
        cleanStoreUrl(savedUrl);

      if (cleanUrl) {
        return cleanUrl;
      }

      const savedPath =
        localStorage.getItem(
          STORE_PATH_KEY
        );

      const cleanPath =
        cleanStoreUrl(savedPath);

      if (cleanPath) {
        return cleanPath;
      }

      const savedStoreNo =
        localStorage.getItem(
          STORE_NO_KEY
        );

      const storeNoUrl =
        cleanStoreUrl(savedStoreNo);

      if (storeNoUrl) {
        return storeNoUrl;
      }

      const savedCode =
        localStorage.getItem(
          STORE_CODE_KEY
        );

      return deriveStoreUrl(
        savedCode
      );
    }

    function openStore() {
      const storeUrl =
        getStoreUrl();

      if (!storeUrl) {
        title.textContent =
          "등록 정보가 없습니다";

        message.textContent =
          "입간판 QR을 다시 스캔하여 우리가게 앱 등록을 먼저 완료해 주세요.";

        message.classList.add(
          "error"
        );

        return;
      }

      window.location.replace(
  "https://wooriapt.ai.kr" + storeUrl
);
    }

    document.addEventListener(
      "DOMContentLoaded",
      openStore
    );
  </script>

</body>
</html>
