{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/mart-manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/android-manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/mart",
      "destination": "/mart.html"
    },
    {
      "source": "/mart-open",
      "destination": "/mart-open.html"
    },
    {
      "source": "/72",
      "destination": "/72.html"
    },
    {
      "source": "/72-android",
      "destination": "/72-android.html"
    },
    {
      "source": "/72-iphone",
      "destination": "/72-iphone.html"
    },
    {
      "source": "/74",
      "destination": "/74.html"
    },
    {
      "source": "/broker-sitemap.xml",
      "destination": "/api/broker-sitemap"
    },
    {
      "source": "/mart-landing",
      "destination": "/mart-landing.html"
    },
    {
      "source": "/mart-price",
      "destination": "/mart-price.html"
    },
    {
      "source": "/price",
      "destination": "/price.html"
    },
    {
      "source": "/mart-search/:region/:city/:place/:mart",
      "destination": "/api/mart-page?mode=mart-page&region=:region&city=:city&place=:place&mart=:mart"
    },
    {
      "source": "/mart-search/:region/:city/:place",
      "destination": "/api/mart-page?mode=mart-page&region=:region&city=:city&place=:place"
    },
    {
      "source": "/sitemaps/marts-:page.xml",
      "destination": "/api/mart-page?mode=mart-sitemap&page=:page"
    },
    {
      "source": "/mart-sitemap.xml",
      "destination": "/api/mart-page?mode=mart-sitemap-index"
    }
  ]
}